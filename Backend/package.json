{
  "name": "backend",
  "version": "1.0.0",
  "description": "Drone'n Play Backend API",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "postinstall": "prisma skills sync || exit 0",
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/node": "^20.19.43",
    "nodemon": "^3.0.1",
    "oxlint": "latest",
    "prettier": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2"
  }
}
